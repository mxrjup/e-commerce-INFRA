# Parametres non secrets de l'environnement, lus par kustomize. Les secrets ne
# vont JAMAIS ici : voir k8s/secrets.example/.
#
# A RENSEIGNER avant le premier deploiement : le nom public fourni par l'ecole.

# Hote de l'Ingress.
PUBLIC_HOST=ecommerce.example.test

# URL publique, le meme hote. Elle fixe l'issuer des jetons (PUBLIC_URL/auth),
# les redirections autorisees du back-office et l'origine CORS. « http:// »
# seulement si l'Ingress n'a pas de TLS, et le realm refusera alors toute
# connexion venant de l'exterieur (sslRequired: external).
PUBLIC_URL=https://ecommerce.example.test
