# Secret « postgres-credentials » : superutilisateur et un mot de passe par
# role applicatif. Lus par le script d'initialisation de PostgreSQL au PREMIER
# demarrage seulement : les changer ensuite ne change pas les mots de passe
# en base, voir le README.
# Generer chaque valeur avec : openssl rand -base64 24
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
CART_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me
