# Secret « keycloak-smtp » : serveur d'envoi des emails de Keycloak
# (verification d'adresse, mot de passe oublie). Obligatoire : le realm
# deploye exige la verification des emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USER=change-me
SMTP_PASSWORD=change-me
# Facultatifs : STARTTLS sur le port 587 par defaut. Pour du TLS direct
# (port 465) : SMTP_STARTTLS=false et SMTP_SSL=true.
# SMTP_STARTTLS=true
# SMTP_SSL=false
